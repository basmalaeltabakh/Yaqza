#═════════════════════════════════════════════════════════════════════════════
# Yaqza Predictive Maintenance API - Lightweight Dockerfile
# Skips heavy packages (TensorFlow) to speed up build
# ═════════════════════════════════════════════════════════════════════════════

FROM python:3.11-slim-bookworm

# ── System Dependencies ─────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# ── Working Directory ────────────────────────────────────────────────────────
WORKDIR /app

# ── Python Environment ───────────────────────────────────────────────────────
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONFAULTHANDLER=1
ENV PIP_NO_CACHE_DIR=1
ENV PIP_DISABLE_PIP_VERSION_CHECK=1

# ── Install Dependencies (lightweight version) ──────────────────────────────
COPY requirements.txt .
RUN pip install --no-cache-dir \
    fastapi==0.111.0 \
    uvicorn[standard]==0.30.0 \
    gunicorn==23.0.0 \
    sqlalchemy==2.0.31 \
    numpy==1.26.4 \
    pandas==2.2.2 \
    scikit-learn==1.5.1 \
    joblib==1.4.2 \
    xgboost==2.1.0 \
    python-dotenv==1.0.1 \
    pydantic==2.8.2 \
    httpx==0.27.0

# Note: TensorFlow, ngboost, tsfresh are skipped for faster build
# CNN-LSTM model won't work, but Ridge/RF/XGBoost will work fine

# ── Application Code ────────────────────────────────────────────────────────
COPY backend/ ./backend/
COPY data/ ./data/
COPY ml/ ./ml/

# ── Set Working Directory to Backend ────────────────────────────────────────
WORKDIR /app/backend

# ── Health Check ────────────────────────────────────────────────────────────
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

# ── Production Server ─────────────────────────────────────────────────────────
CMD ["gunicorn", "main_fixed:app", "--workers", "2", "--worker-class", "uvicorn.workers.UvicornWorker", "--bind", "0.0.0.0:8000", "--timeout", "120"]